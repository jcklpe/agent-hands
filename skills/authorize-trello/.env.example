# Literal provider settings; never source this file as shell code.
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_WRITE_TOKEN=
# Comma-separated board IDs for exports/default-board resolution. No default board is built in.
TRELLO_BOARD_IDS=
# Optional lists whose cards must have a start date; the tool installs no automation.
TRELLO_SNOOZE_LISTS=
