# Literal values only; no shell expansion. Existing exported ODOO_* variables take precedence.
ODOO_API_KEY=
# Optional paths are relative to this authorization skill folder, not the current project.
ODOO_ACCOUNTS_PATH=odoo-accounts.json
ODOO_REQUEST_STATE_PATH=odoo-last-request
ODOO_MIN_REQUEST_INTERVAL_SECONDS=5
