#!/usr/bin/env bash
set -o pipefail
TRELLO_USE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)" || exit 1
TRELLO_AUTH_DIR="$(cd "${TRELLO_USE_DIR}/../setup-trello" && pwd)" || exit 1
. "${TRELLO_AUTH_DIR}/scripts/client.sh"
. "${TRELLO_USE_DIR}/scripts/operations.sh"
. "${TRELLO_USE_DIR}/scripts/export.sh"
. "${TRELLO_USE_DIR}/scripts/mutations.sh"
command_name="${1:-help}"
[ "$#" -eq 0 ] || shift
case "$command_name" in
    help|--help|-h)
        cat <<'USAGE'
Trello: bounded reads, previewed writes, and explicit Markdown exports.
  trello list-boards
  trello list-lists [BOARD_ID]
  trello list-labels [BOARD_ID]
  trello export --output FILE
  trello add-card --list NAME_OR_ID --name NAME [--board ID] [--desc TEXT | --desc-file FILE]
  trello move-card --card CARD --list NAME_OR_ID [--board ID]
  trello schedule-card --card CARD --list NAME_OR_ID --until YYYY-MM-DD [--board ID]
  trello rename-card --card CARD --name NAME
  trello set-desc --card CARD --file FILE
  trello comment --card CARD (--text TEXT | --file FILE)
  trello add-checklist --card CARD --name NAME [--item TEXT]...
  trello add-checklist-item --card CARD --checklist NAME_OR_ID --text TEXT [--text TEXT]...
  trello check-item --card CARD --item NAME_OR_ID [--checklist NAME_OR_ID]
  trello uncheck-item --card CARD --item NAME_OR_ID [--checklist NAME_OR_ID]
  trello create-label --name NAME [--color COLOR] [--board ID]
  trello add-label --card CARD --label NAME_OR_ID [--board ID]
  trello remove-label --card CARD --label NAME_OR_ID [--board ID]
  trello delete-label --label NAME_OR_ID [--board ID]
  trello supersede --from CARD --to CARD
  trello supersede --create --from CARD --list NAME_OR_ID --name NAME [--board ID] [--desc TEXT | --desc-file FILE]
  trello chain --card CARD [--json]
All 15 mutation commands preview by default. Add --execute to write.
Use --expect PREVIEW_HASH to bind execution to a reviewed preview; --json emits JSON.
Targets are revalidated before writes and each step is read back. Partial failures stop without retry.
Trello has no atomic multi-step transaction; review failures before retrying.
No card deletion/archive or generic API command. Setup and account access: setup-trello/SKILL.md.
USAGE
        exit 0 ;;
esac
_trello_load_env || exit 1
case "$command_name" in
    list-boards) _trello_list_boards "$@" ;;
    list-lists) _trello_list_lists "$@" ;;
    list-labels) _trello_list_labels "$@" ;;
    export) _trello_export "$@" ;;
    add-card|move-card|schedule-card|rename-card|set-desc|comment|add-checklist|add-checklist-item|check-item|uncheck-item|create-label|add-label|remove-label|delete-label|supersede)
        _trello_mutation "$command_name" "$@" ;;
    chain)
        # Check option arity before entering the existing parsers, avoiding a failed shift loop.
        options=("$@")
        while [ "$#" -gt 0 ]; do
            case "$1" in
                --create|--json) shift ;;
                --*) [ "$#" -ge 2 ] || { _trello_error "Missing value for $1"; exit 1; }; shift 2 ;;
                *) _trello_error "Unexpected argument: $1"; exit 1 ;;
            esac
        done
        function_name="_trello_${command_name//-/_}"
        "$function_name" "${options[@]}" ;;
    *) _trello_error "Unknown Trello command: $command_name"; exit 1 ;;
esac
