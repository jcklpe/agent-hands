#!/usr/bin/env bash
set -o pipefail
GITHUB_USE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)" || exit 1
GITHUB_AUTH_DIR="$(cd "${GITHUB_USE_DIR}/../authorize-github" && pwd)" || exit 1
. "${GITHUB_AUTH_DIR}/scripts/client.sh"
. "${GITHUB_USE_DIR}/scripts/operations.sh"
command_name="${1:-help}"
[ "$#" -eq 0 ] || shift
case "$command_name" in
    help|--help|-h)
        printf 'GitHub projects: export REPO_OR_ALIAS --output DIRECTORY; list-repos\n'
        printf 'Projects export requires a configured alias. move-card --repo ALIAS --issue NUMBER --status NAME [--execute | --dry-run] (first configured organization project)\n'
        exit 0 ;;
esac
_github_load_env || exit 1
case "$command_name" in
    list-repos) _github_list_repos ;;
    export)
        repo=""; output=""
        while [ "$#" -gt 0 ]; do
            case "$1" in
                --output) [ -n "${2:-}" ] || { _github_error '--output requires DIRECTORY'; exit 1; }; output="$2"; shift 2 ;;
                -*) _github_error "Unknown export option: $1"; exit 1 ;;
                *) [ -z "$repo" ] || { _github_error 'Select one repository per export'; exit 1; }; repo="$1"; shift ;;
            esac
        done
        [ -n "$repo" ] && [ -n "$output" ] || { _github_error 'export requires REPO_OR_ALIAS --output DIRECTORY'; exit 1; }
        _github_export_projects "$repo" "$output" ;;
    move-card) _github_move_card "$@" ;;
    *) _github_error "Unknown command: $command_name"; exit 1 ;;
esac
