#!/usr/bin/env bash
set -o pipefail
GITHUB_USE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)" || exit 1
GITHUB_AUTH_DIR="$(cd "${GITHUB_USE_DIR}/../setup-github" && pwd)" || exit 1
. "${GITHUB_AUTH_DIR}/scripts/client.sh"
. "${GITHUB_USE_DIR}/scripts/operations.sh"
command_name="${1:-help}"
[ "$#" -eq 0 ] || shift
case "$command_name" in
    help|--help|-h)
        printf 'GitHub projects: export REPO_OR_ALIAS --output DIRECTORY; list-repos\n'
        printf 'Collaboration: read-project, read-view, create-project, copy-project, link-repository, ensure-field, create-view, edit-view, add-item, move-card, automation-config, recover\n'
        printf 'Pass COMMAND --help for exact selectors and preview/execute guards. Projects export requires a configured alias.\n'
        exit 0 ;;
esac
_github_load_env || exit 1
case "$command_name" in
    read-project|read-view|create-project|copy-project|link-repository|ensure-field|create-view|edit-view|add-item|move-card|automation-config|recover)
        _github_render_file "${GITHUB_USE_DIR}/scripts/collaborate.py" "$command_name" "$@" ;;
    list-repos) _github_list_repos ;;
    export)
        repo=""; output=""
        while [ "$#" -gt 0 ]; do
            case "$1" in
                --output) [ -n "${2:-}" ] || { _github_error '--output requires DIRECTORY'; exit 1; }; output="$2"; shift 2 ;;
                -*) _github_error "Unknown export option: $1"; exit 1 ;;
                *) [ -z "$repo" ] || { _github_error 'Select one repository per export'; exit 1; }; repo="$1"; shift ;;
            esac
        done
        [ -n "$repo" ] && [ -n "$output" ] || { _github_error 'export requires REPO_OR_ALIAS --output DIRECTORY'; exit 1; }
        _github_export_projects "$repo" "$output" ;;
    *) _github_error "Unknown command: $command_name"; exit 1 ;;
esac
