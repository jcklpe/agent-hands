# Literal values only: no shell expansion. Relative paths resolve beside this authorization skill.
GOOGLE_ACCOUNTS_PATH=google-accounts.json
# Optional Python 3.11+ executable; otherwise uv provisions the declared runtime.
# GOOGLE_PYTHON=/absolute/path/to/python
# Optional Gmail operational settings; relative audit paths resolve beside use-gmail.
# GOOGLE_GMAIL_AUDIT_LOG=mail-writes.jsonl
# GOOGLE_GMAIL_MAX_RETRIES=5
