#!/usr/bin/env bash
ODOO_USE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ODOO_AUTH_DIR="$(cd "${ODOO_USE_DIR}/../setup-odoo" && pwd)" || exit 1
. "${ODOO_AUTH_DIR}/scripts/client.sh"
. "${ODOO_USE_DIR}/scripts/operations.sh"
case "${1:-help}" in
    help|--help|-h)
        cat <<'USAGE'
Odoo projects and tasks: bounded reads and explicit writes.
  odoo accounts
  odoo projects list ALIAS [--json]
  odoo stages list ALIAS --project PROJECT_ID [--json]
  odoo tasks list ALIAS --project PROJECT_ID [--stage STAGE_ID] [--limit COUNT] [--json]
  odoo tasks find ALIAS QUERY --project PROJECT_ID [--json]
  odoo tasks get ALIAS TASK_ID [--json]
  odoo tasks comments ALIAS TASK_ID [--limit COUNT] [--json]
  odoo tasks create ALIAS --project PROJECT_ID --name NAME [--description TEXT | --description-file FILE] [--stage STAGE_ID] [--assignee USER_ID]... [--deadline YYYY-MM-DD] [--execute] [--json]
  odoo tasks update ALIAS TASK_ID [--name NAME] [--description TEXT | --description-file FILE] [--stage STAGE_ID] [--assignee USER_ID]... [--clear-assignees] [--deadline YYYY-MM-DD | --clear-deadline] [--execute] [--json]
  odoo tasks comment ALIAS TASK_ID [--body TEXT | --body-file FILE] [--execute] [--json]
Configuration belongs to setup-odoo; no workspace/vault configuration is needed.
USAGE
        exit 0 ;;
esac
_odoo_load_env || exit 1
_odoo_dispatch "$@"
